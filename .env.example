LLM_PROVIDER=local
# Set to mistral to enable the optional Mistral integration
# MISTRAL_API_KEY=your_mistral_api_key_here
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_EMBED_MODEL=mistral-embed

# --- Vector retrieval (Qdrant) ---
# With no QDRANT_URL configured the app uses an embedded in-memory store,
# so semantic search works out of the box without any server.
# USE_QDRANT=true
# QDRANT_MODE=auto              # auto | cloud | memory | disable
# QDRANT_URL=https://your-cluster.eu-central-1-0.aws.cloud.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key_if_required
# QDRANT_COLLECTION=parcelpilot_docs
# QDRANT_TIMEOUT_SECONDS=15

# --- Agent behaviour ---
# AGENT_MODE=rules              # rules | langchain (opt-in autonomous tool-calling)
